# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Copy exact model IDs from tokenfactory.nebius.com -> Models
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

TAVILY_API_KEY=

# Shared secret the ESP32 sends in the X-Unit-Key header
INGEST_KEY=change-me
DB_PATH=nightlight.sqlite
